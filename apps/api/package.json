{
  "name": "api",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "generate": "prisma generate --config ../../prisma.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:int": "vitest run --config vitest.int.config.ts",
    "openapi": "turbo run build --filter=api --output-logs=errors-only && node scripts/openapi.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@point/documents": "workspace:*",
    "@point/i18n": "workspace:*",
    "@point/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nestjs": "11.8.0",
    "express": "5.2.1",
    "nodemailer": "10.0.15",
    "openid-client": "6.8.8",
    "pg-boss": "12.37.0",
    "pino": "10.4.0",
    "playwright-core": "1.63.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "pdfjs-dist": "6.4.299",
    "supertest": "7.3.1",
    "typescript": "6.0.3"
  }
}
