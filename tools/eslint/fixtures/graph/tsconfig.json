{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@point/shared": ["packages/shared/src/index.ts"],
      "@point/ui": ["packages/ui/src/index.ts"],
      "@point/i18n/*": ["packages/i18n/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
