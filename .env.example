# Copy to .env (git-ignored) and fill in. Read by docker compose and by host-run tools (pnpm dev,
# pnpm db:migrate, pnpm test:int). Every variable has a one-line comment (design D13 · CG-SEC-05).
# tools/guards/check-env-example.mjs keeps this file equal to the compose files, the Caddyfile and
# the API / web environment schemas. Values below are for local development.

# --- origins
# Public website host; production: https://<your public domain>.
SITE_ORIGIN=https://point.test
# Staff app host; production: https://app.<your domain>.
APP_ORIGIN=https://app.point.test

# --- database
# Database name created by the postgres container on its first start.
POSTGRES_DB=point
# Owner role: runs the migrations, never used by the API.
POSTGRES_USER=point
# Owner role password (URL-safe characters: it is repeated in MIGRATE_DATABASE_URL).
POSTGRES_PASSWORD=change-me-owner
# Password of role point_app, set by db/bootstrap/00-roles.sh (URL-safe: repeated in DATABASE_URL).
POINT_APP_DB_PASSWORD=change-me-app
# API connection as point_app. Host `postgres` is the service; host-run tools reach it through the hosts-file line 127.0.0.1 postgres.
DATABASE_URL=postgresql://point_app:change-me-app@postgres:5432/point
# Owner connection for db/scripts/migrate.mjs (the migrate service, pnpm db:migrate).
MIGRATE_DATABASE_URL=postgresql://point:change-me-owner@postgres:5432/point

# --- internal secrets (ADR-009): required, at least 16 characters each and different from each other, e.g. `openssl rand -hex 32` — the API does not start otherwise
# Key the web app's server side sends to the internal API (api + web only).
INTERNAL_SSR_KEY=
# Key the ops jobs send to the internal API (api + backup only — never the web container).
INTERNAL_OPS_KEY=

# --- bucket (ADR-014)
# reserved: add-attachments-upload reads S3_ENDPOINT, S3_REGION, S3_BUCKET_APP and the S3_* keys; add-backup-restore reads S3_BUCKET_BACKUP and the BACKUP_S3_* keys
# S3-compatible endpoint; local minio (--profile storage): http://localhost:9000.
S3_ENDPOINT=
# Bucket region.
S3_REGION=
# Bucket for uploaded files and generated documents.
S3_BUCKET_APP=
# Bucket for database backups.
S3_BUCKET_BACKUP=
# Access key of the API's bucket user.
S3_ACCESS_KEY_ID=
# Secret key of the API's bucket user.
S3_SECRET_ACCESS_KEY=
# Access key of the backup bucket user.
BACKUP_S3_ACCESS_KEY_ID=
# Secret key of the backup bucket user.
BACKUP_S3_SECRET_ACCESS_KEY=

# --- runtime
# Release tag of the images (build argument); reported by GET /api/v1/system/status.
APP_VERSION=0.0.0-dev
# Port the API listens on inside its container (pnpm dev uses 3101).
API_PORT=3001
# API log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# API base the browser calls — a same-origin path (ADR-009 action item 3).
NEXT_PUBLIC_API_BASE=/api/v1
# API base the web app's server side calls over the Docker network.
API_INTERNAL_BASE=http://api:3001/api/v1

# --- edge (Caddy)
# API upstream; host-run API: host.docker.internal:3101.
API_UPSTREAM=api:3001
# Web upstream; host-run web app: host.docker.internal:3100.
WEB_UPSTREAM=web:3000
# Request body cap on the staff host: upload limit 10 MB + 1 MB (API-LIM-03).
CADDY_MAX_BODY=11MB
# Extra Caddy global options; empty in production, docker-compose.dev.yml sets local_certs.
CADDY_GLOBAL_OPTIONS=
# Strict-Transport-Security value; production max-age=31536000, docker-compose.dev.yml sets max-age=0.
CADDY_HSTS=max-age=31536000
