# Copy to .env (git-ignored) and fill in. Read by docker compose and by host-run tools: pnpm dev and the
# pnpm db:* scripts (pnpm test:int takes DATABASE_URL from the shell). Every variable has a one-line
# comment (design D13 · CG-SEC-05).
# tools/guards/check-env-example.mjs keeps this file equal to the compose files, the Caddyfile and
# the API / web environment schemas. Values below are for local development.

# --- origins
# Public website host; production: https://<your public domain>.
SITE_ORIGIN=https://point.test
# Staff app host; production: https://app.<your domain>.
APP_ORIGIN=https://app.point.test

# --- database
# Database name created by the postgres container on its first start.
POSTGRES_DB=point
# Owner role: runs the migrations, never used by the API.
POSTGRES_USER=point
# Owner role password (URL-safe characters: it is repeated in MIGRATE_DATABASE_URL).
POSTGRES_PASSWORD=change-me-owner
# Password of role point_app, set by db/bootstrap/00-roles.sh (URL-safe: repeated in DATABASE_URL).
POINT_APP_DB_PASSWORD=change-me-app
# API connection as point_app. Host `postgres` is the service; host-run tools reach it through the hosts-file line 127.0.0.1 postgres.
DATABASE_URL=postgresql://point_app:change-me-app@postgres:5432/point
# Owner connection for db/scripts/migrate.mjs (the migrate service, pnpm db:migrate).
MIGRATE_DATABASE_URL=postgresql://point:change-me-owner@postgres:5432/point

# --- internal secrets (ADR-009): required, at least 16 characters each and different from each other, e.g. `openssl rand -hex 32` — the API does not start otherwise
# Key the web app's server side sends to the internal API (api + web only).
INTERNAL_SSR_KEY=
# Key the ops jobs send to the internal API (api + backup only — never the web container).
INTERNAL_OPS_KEY=

# --- sign-in, mail and jobs (add-foundation-auth-access — design D18): api only
# Kind of environment: development, test, staging or production (the start-up checks depend on it).
APP_ENV=development
# Secure flag of the session cookie; false is accepted only when APP_ENV is development or test.
SESSION_COOKIE_SECURE=true
# HMAC key of the e-mail sign-in codes: required, at least 32 bytes, e.g. `openssl rand -hex 32` — the API does not start otherwise.
OTP_HMAC_SECRET=
# HMAC key of the e-mail address in login.failed audit rows: required, at least 32 bytes, e.g. `openssl rand -hex 32`.
AUDIT_HASH_SECRET=
# AES-256-GCM key of the queued sign-in e-mail: required, exactly 32 bytes in base64, e.g. `openssl rand -base64 32`.
MAIL_PAYLOAD_KEY=
# Mail transport: mailpit (local, CI) or resend (production; elsewhere only with MAIL_ALLOW_REAL=true).
MAIL_TRANSPORT=mailpit
# Sender of every e-mail.
MAIL_FROM=Point Barbershop <no-reply@point.test>
# SMTP host of Mailpit (MAIL_TRANSPORT=mailpit); the dev stack's service is mailpit.
SMTP_HOST=mailpit
# SMTP port of Mailpit.
SMTP_PORT=1025
# Resend API key (MAIL_TRANSPORT=resend) — a provider secret (docs/ops/secrets-rotation.md).
RESEND_API_KEY=
# true lets a non-production environment send real e-mail through Resend; keep false.
MAIL_ALLOW_REAL=false
# OAuth client id of Google sign-in (Google Cloud console).
GOOGLE_CLIENT_ID=change-me-google-client-id
# OAuth client secret of Google sign-in — a provider secret (docs/ops/secrets-rotation.md).
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
# OpenID issuer of Google sign-in; the integration tests point it at a stub issuer.
GOOGLE_ISSUER=https://accounts.google.com
# Proxies in front of the API whose X-Forwarded-For entry is trusted (Caddy = 1).
TRUSTED_PROXY_HOPS=1
# Company name in Myanmar, written to the one companies row on the first start.
COMPANY_NAME_MM=ပွိုင့် ဘာဘာရှော့
# Company name in English (optional).
COMPANY_NAME_EN=Point Barbershop
# true runs the job workers inside the API process (ADR-002).
JOBS_IN_API=true

# --- bucket (ADR-014) — read by the API since add-walkin-visit-checkout (receipts). The values below
# are the local minio of docker-compose.dev.yml (--profile storage); production uses the owner's bucket.
# S3-compatible endpoint; local minio: http://localhost:9000.
S3_ENDPOINT=http://localhost:9000
# Bucket region (minio accepts any; R2 uses auto).
S3_REGION=us-east-1
# Bucket for uploaded files and generated documents.
S3_BUCKET_APP=point-app
# Access key of the API's bucket user (local minio: its development user).
S3_ACCESS_KEY_ID=minio-dev
# Secret key of the API's bucket user (local minio: its development password, never a real one).
S3_SECRET_ACCESS_KEY=minio-dev-only

# --- backup bucket (ADR-014)
# reserved: add-backup-restore reads S3_BUCKET_BACKUP and the BACKUP_S3_* keys
# Bucket for database backups.
S3_BUCKET_BACKUP=
# Access key of the backup bucket user.
BACKUP_S3_ACCESS_KEY_ID=
# Secret key of the backup bucket user.
BACKUP_S3_SECRET_ACCESS_KEY=

# --- runtime
# Release tag of the images (build argument); reported by GET /api/v1/system/status.
APP_VERSION=0.0.0-dev
# Port the API listens on inside its container (pnpm dev uses 3101).
API_PORT=3001
# API log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# API base the browser calls — a same-origin path (ADR-009 action item 3).
NEXT_PUBLIC_API_BASE=/api/v1
# API base the web app's server side calls over the Docker network.
API_INTERNAL_BASE=http://api:3001/api/v1

# --- edge (Caddy)
# API upstream; host-run API: host.docker.internal:3101.
API_UPSTREAM=api:3001
# Web upstream; host-run web app: host.docker.internal:3100.
WEB_UPSTREAM=web:3000
# Request body cap on the staff host: upload limit 10 MB + 1 MB (API-LIM-03).
CADDY_MAX_BODY=11MB
# Extra Caddy global options; empty in production, docker-compose.dev.yml sets local_certs.
CADDY_GLOBAL_OPTIONS=
# Strict-Transport-Security value; production max-age=31536000, docker-compose.dev.yml sets max-age=0.
CADDY_HSTS=max-age=31536000
