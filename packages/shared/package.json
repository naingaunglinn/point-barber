{
  "name": "@point/shared",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "definitions"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/fixture-ids.ts",
      "types": "./dist/testing/fixture-ids.d.ts",
      "default": "./dist/testing/fixture-ids.js"
    },
    "./definitions/*.json": "./definitions/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "permissions:generate": "node scripts/generate-permissions.mjs",
    "typecheck": "tsc --noEmit",
    "test:zones": "node ../../tools/test-zones.mjs packages/shared/src/time packages/shared/src/format"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@point/i18n": "workspace:*",
    "date-fns": "4.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
