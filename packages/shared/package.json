{
  "name": "@point/shared",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "definitions"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definitions/*.json": "./definitions/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:zones": "node scripts/test-zones.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@point/i18n": "workspace:*",
    "date-fns": "4.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
