  @@unique([schedule_shift_id, exception_type], map: "attendance_exceptions_one_per_shift", where: raw("((schedule_shift_id IS NOT NULL) AND (status <> 0))"))
  @@index([branch_id, business_date, status])
  @@index([employee_id, business_date])
  @@index([branch_id, business_date], map: "attendance_exceptions_open", where: raw("(status = 1)"))
  @@index([status, detected_at])
}

