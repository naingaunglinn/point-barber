  leaves                   leaves?                    @relation(fields: [leave_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                    users?                     @relation(fields: [resolved_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule_shifts          schedule_shifts?           @relation(fields: [schedule_shift_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
