{
  "name": "point-barber",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "node tools/git-hooks/install.mjs",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:int": "turbo run test:int",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guards": "node tools/guards/run-all.mjs",
    "fonts:check": "node tools/guards/check-fonts.mjs",
    "i18n:check": "node tools/guards/check-i18n.mjs",
    "db:migrate": "node --env-file-if-exists=.env db/scripts/migrate.mjs",
    "db:build-baseline": "node db/scripts/build-baseline.mjs",
    "db:test": "node --env-file-if-exists=.env db/scripts/run-constraint-tests.mjs",
    "db:check-source": "node db/scripts/check-source.mjs",
    "db:check-introspection": "node --env-file-if-exists=.env db/scripts/check-introspection.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-plugin-n": "18.4.1",
    "globals": "17.13.0",
    "pg-boss": "12.37.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
